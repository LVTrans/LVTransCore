@startuml

class Port {
  + Port(owner, type)
  + connect(other)
  + reset()
  + is_connected()
  + get_owner(): Element
  + get_type(): PortType
  - connected_to: *Port
  - owner: &Element
  - type: PortType
}

abstract class Element {
  # ports: array<optional<Port>, 4>
  # id: ElementID
  # type: ElementType
  + set_port(type, port): void
  + get_ports(): array<optional<Port>, 4>
  + set_name(name)
  + get_name(): string 
  + get_ID(): int
  + get_parameters(): void
  + get_state(): ElementState
  + get_first_available_port(): const Port*
  + connect_to(other, from, to): void
  + reset_ports()
  
}

abstract class NonPipe {
  # c_characteristic: double
  # b_characteristic: double
  + set_c_characteristic(val): void
  + set_b_characteristic(val): void
  + get_Q(): double
  + get_H(): double

}

abstract class BasePipe {
  - H: vector<double>
  - Q: vector<double>
  + get_H()
  + get_Q()
  + remove_left()
  + remove_right()
}

class ConcreteNonPipe  {
  + ConcreteNonPipe(id: int)
}

class ConcretePipe {
  + ConcretePipe(id: int)
}


class Plant {
  - data: PlantData
  + Plant(file_path)
  + Plant(plantData)
  + step() 
  + run_steps(steps) 
  + get_state()
  + save_data(path)
  + load_data(path)
  + save_state(path)
  + modify_element(id, modification)
  + add_element<T>(args)
  + add_element_with_id<T>(id, args)
  + get_element_by_ID(id)
  + get_pipes() 
  + get_non_pipes()
  + get_elements()
  + remove_element_by_id(id)
}


object PlantData {
  + element_container: ElementContainer
  + state: PlantState
  + config: SimulationConfig
  + meta: PlantMetaData
}


class ElementContainer {
  - pipes: vector<unique_ptr<BasePipe>>
  - non_pipes: vector<unique_ptr<NonPipe>>
  - element_indicies: map<ElementID, pair<ElementAbstractType, int>>
  + ElementContainer()
  + add_element<T>(args)
  + add_element_with_id<T>(id, args)
  + get_element_by_ID(id)
  + get_pipes() 
  + get_non_pipes()
  + get_elements()
  + remove_element_by_id(id)
}


class PlantConfigurationRepository << (S,#FF7700) Singleton >> {
  + read_plant_from_file(path): PlantConfiguration
  + save_plant_to_file(path, plant): Result
}

abstract class ElementParser {
  + parse(container, element_config)
}

class ConcreteElementParser {
  + parse(container, element_config)
}




' Relations
Plant -- PlantData

Element <|-- NonPipe
Element <|-- BasePipe
Element ||--o{ Port

NonPipe <|-- ConcreteNonPipe
BasePipe <|-- ConcretePipe

ElementParser <|-- ConcreteElementParser


ElementContainer -- Element

PlantData -- ElementContainer
Plant -- PlantConfigurationRepository

@enduml
