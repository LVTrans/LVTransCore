@startuml

abstract class Element {
  # id: ElementID
  # type: ElementType
  + set_name(name)
  + get_name(): string
  + get_ID(): int
  + get_parameters(): void
  + get_state(): ElementState

}

abstract class NonPipe {
  - left: vector<PipeLink>
  - right: vector<PipeLink>
  # map<ElementID, Characteristics> c_plus{};
  # map<ElementID, Characteristics> c_minus{};
  + left_links(): span<const PipeLink>
  + right_links(): span<const PipeLink>
  + disconnect_all()
  + set_c_characteristic(val): void
  + set_b_characteristic(val): void
  + get_Q(): double
  + get_H(): double

}

abstract class BasePipe {
  - left: BoundaryLink
  - right: BoundaryLink
  - params: PipeParameters
  - derived_data: PipeState
  - state: PipeState
  - initial_state: PipeState
  + get_H()
  + get_Q()
  + disconnect_all()
  + left_element(): 
  + right_element(): 
}

class ConcreteNonPipe  {
  + ConcreteNonPipe(id: int)
}

class ConcretePipe {
  + ConcretePipe(id: int)
}


class Plant {
  - data: PlantData
  + Plant(file_path)
  + Plant(plantData)
  + step()
  + run_steps(steps)
  + get_state()
  + save_data(path)
  + load_data(path)
  + save_state(path)
  + modify_element(id, modification)
  + add_element<T>(args)
  + add_element_with_id<T>(id, args)
  + get_element_by_ID(id)
  + get_pipes()
  + get_non_pipes()
  + get_elements()
  + remove_element_by_id(id)
}


object PlantData {
  + element_container: ElementContainer
  + state: PlantState
  + config: SimulationConfig
  + meta: PlantMetaData
}


class ElementContainer {
  - element_id: ElementID
  - pipes: vector<unique_ptr<BasePipe>>
  - non_pipes: vector<unique_ptr<NonPipe>>
  - element_indicies: map<ElementID, pair<ElementAbstractType, int>>
  + ElementContainer()
  + add_element<T>(args)
  + add_element_with_id<T>(id, args)
  + get_element_by_ID(id)
  + get_pipes()
  + get_non_pipes()
  + get_elements()
  + remove_element_by_id(id)
}


class PlantConfigurationRepository << (S,#FF7700) Singleton >> {
  + load(path, &plant_data): PlantRepositoryResult
  + save(path, &plant_data): PlantRepositoryResult
}

abstract class ElementParser {
  + parse(container, element_config, step_size)
}

class ConcreteElementParser {
  + parse(container, element_config, step_size)
}




class HydraulicConnections {
  {static} + connect(BasePipe&, PipeEnd, NonPipe&, index)
  {static} + disconnect(BasePipe&, PipeEnd)
  {static} + disconnect_all(BasePipe&)
  {static} + disconnect_all(NonPipe&)
}

class BoundaryLink {
  + element: NonPipe*
  + terminal: TerminalId
}
class PipeLink {
  + pipe: BasePipe*
  + end: PipeEnd
}
class TerminalId {
  + side: Side
  + index: size_t
}

' Relations
HydraulicConnections ..> BasePipe : maintains links
HydraulicConnections ..> NonPipe : maintains links
BasePipe *-- BoundaryLink
NonPipe *-- PipeLink
BoundaryLink -- TerminalId
Plant -- PlantData

Element <|-- NonPipe
Element <|-- BasePipe

NonPipe <|-- ConcreteNonPipe
BasePipe <|-- ConcretePipe
BasePipe "0..*" -- "0..2" NonPipe : hydraulic connections


ElementParser <|-- ConcreteElementParser


ElementContainer -- Element

PlantData -- ElementContainer
Plant -- PlantConfigurationRepository

@enduml
