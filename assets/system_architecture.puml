@startuml


skinparam linetype ortho
skinparam nodesep 35
skinparam ranksep 45
skinparam packageStyle rectangle
skinparam shadowing false

hide empty members


abstract class Element {
  # id: ElementID
  # name: string
  + get_type(): ElementType {abstract}
  + get_parameters(): ElementParameters {abstract}
  + get_state(): ElementState {abstract}
  + reset_state(): void {abstract}
  + modify(element_modification): ModificationResult {abstract}
  + iterate(step_size): void {abstract}

}

abstract class NonPipe {
  + NonPipe(left_count, right_count)
  - left: vector<PipeLink>
  - right: vector<PipeLink>
  # map<ElementID, Characteristics> c_plus{};
  # map<ElementID, Characteristics> c_minus{};
  + left(index): BasePipe*
  + right(index): BasePipe*
  + set_characteristics(characteristics, element_id): void
  + get_Q(characteristics_type, element_id): double
  + get_H(characteristics_type, element_id): double

}

abstract class BasePipe {
  - left: BoundaryLink
  - right: BoundaryLink
  - params: PipeParameters
  - derived: PipeDerivedData
  - state: PipeState
  - initial_state: PipeState
  + left(): NonPipe*
  + right(): NonPipe*
  + update_boundaries(): void
  + update_characteristics(): void
}
abstract class Controller {
  # controllable: Controllable*
  {abstract} + get_output: double
  {abstract} + is_active: bool
  + get_controllable(): Controllable*
  + disconnect_all(): void
}

abstract class Controllable {
  # controller: Controller*
  {abstract} + get_measurement: double
  + get_controller(): Controller*
}


class Plant {
  - data: PlantData
  + Plant(file_path)
  + Plant(plantData)
  + step()
  + step(num_steps)
  + reset_state()
  + save(path)
  + load(path)
  + modify_element(id, modification)
  + add_element<T>(args)
  + add_element_with_id<T>(id, args)
  + get_element_by_ID(id)
  + remove_element_by_id(id)
  + get_elements()
}


object PlantData {
  + element_container: ElementContainer
  + state: PlantState
  + config: SimulationConfig
  + meta: PlantMetaData
}


class ElementContainer {
  - element_id: ElementID
  - pipes: vector<unique_ptr<BasePipe>>
  - non_pipes: vector<unique_ptr<NonPipe>>
  - controllers: vector<unique_ptr<Controller>>
  - element_indicies: map<ElementID, pair<ElementAbstractType, int>>
  + add_element<T>(args)
  + add_element_with_id<T>(id, args)
  + get_element_by_ID(id)
  + remove_element_by_id(id)
  + get_elements()
}


class PlantConfigurationRepository << (S,#FF7700) Static >> {
  + load(path, &plant_data): PlantRepositoryResult
  + save(path, &plant_data): PlantRepositoryResult
}

abstract class ElementParser {
  + parse(&container, &element_config, step_size): ElementParserResult {abstract}
}

class ElementParserFactory << (S,#FF7700) Static >> {
  + create(element_type): unique_ptr<ElementParser>
}

class HydraulicConnections {
  {static} + connect(&pipe, pipe_end, &non_pipe, terminal_index)
  {static} + disconnect(&pipe, pipe_end)
  {static} + disconnect_all(&pipe)
  {static} + disconnect_all(&non_pipe)
}

class ControllerConnections {
  {static} + connect(&controller, &controllable)
  {static} + disconnect(&controller, &controllable)
  {static} + disconnect_all(&controller)
  {static} + disconnect_all(&controllable)
}

' Relations
HydraulicConnections ..> BasePipe 
HydraulicConnections ..> NonPipe 

ControllerConnections ..> Controller 
ControllerConnections ..> Controllable 


Controllable -- Controller
Plant -- PlantData

Element <|-- NonPipe
Element <|-- BasePipe
Element <|-- Controller

BasePipe -- NonPipe 

ElementParserFactory --> ElementParser


ElementContainer -- Element

PlantData -- ElementContainer
Plant -- PlantConfigurationRepository

@enduml
